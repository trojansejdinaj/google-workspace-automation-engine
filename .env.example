# Google Workspace Automation Engine environment example
#
# Copy this file to .env for local use:
#   cp .env.example .env
#
# Keep .env private. Leave values blank unless your local run needs them.

# Core settings
# Optional profile label for local workflows.
GW_PROFILE=local

# Optional debug flag. Use true only for local troubleshooting.
GW_DEBUG=false

# Optional log level.
GW_LOG_LEVEL=INFO

# Optional runs directory. Blank uses the application default.
GW_RUNS_DIR=

# Google authentication
# Optional for Drive/Sheets service-account runs. Set to a private local path outside git.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional OAuth credentials. Required for Gmail workflows and OAuth-based Drive/Sheets runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# HTTP timeout and retry behavior
# Optional; application defaults are used when blank.
GW_HTTP_TIMEOUT_S=
GW_HTTP_MAX_RETRIES=
GW_HTTP_INITIAL_BACKOFF_S=
GW_HTTP_MAX_BACKOFF_S=
GW_HTTP_JITTER_RATIO=

# Testing and local verification
# Optional. Use private local spreadsheet IDs only in .env, never here.
GW_TEST_SHEET_ID=
GW_SA_TEST_SHEET_ID=
